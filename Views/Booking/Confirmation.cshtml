@model EventPack.Models.Db.Booking

@{
    ViewData["Title"] = "ยืนยันการจอง";
    
    // Parse menu items JSON
    System.Text.Json.JsonElement? menuData = null;
    if (!string.IsNullOrEmpty(Model.MenuItemsJson))
    {
        try
        {
            var jsonDoc = System.Text.Json.JsonDocument.Parse(Model.MenuItemsJson);
            menuData = jsonDoc.RootElement;
        }
        catch { }
    }
}

<div class="confirmation-container">
    <div class="confirmation-card success">
        <div class="success-icon">✓</div>
        
        <h2>ยืนยันการจองสำเร็จ!</h2>
        <p class="success-subtitle">ขอบคุณที่ใช้บริการของเรา</p>

        <div class="booking-details">
            <div class="detail-section">
                <h3>รายละเอียดการจอง</h3>
                
                <div class="detail-row">
                    <span class="label">หมายเลขการจอง:</span>
                    <span class="value booking-id">@Model.BookingId</span>
                </div>

                <div class="detail-row">
                    <span class="label">จำนวนคน:</span>
                    <span class="value">@Model.TotalGuests คน</span>
                </div>

                <div class="detail-row">
                    <span class="label">วันที่จัดงาน:</span>
                    <span class="value">
                        @if (Model.EventDate.HasValue)
                        {
                            @Model.EventDate.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-muted">ยังไม่ระบุ</span>
                        }
                    </span>
                </div>

                <div class="detail-row">
                    <span class="label">ที่อยู่จัดงาน:</span>
                    <span class="value">@Model.EventLocation</span>
                </div>

                @if (ViewBag.UserInfo != null)
                {
                    <div class="detail-row">
                        <span class="label">เบอร์ติดต่อ:</span>
                        <span class="value">@ViewBag.UserInfo.UserPhone</span>
                    </div>
                }
            </div>

            <!-- Menu Items Section -->
            @if (menuData.HasValue)
            {
                <div class="menu-details-section">
                    <h3>🍽️ เมนูอาหารที่เลือก</h3>
                    <div class="menu-items-list">
                        @try
                        {
                            if (menuData.Value.TryGetProperty("items", out var itemsArray))
                            {
                                @foreach (var itemId in itemsArray.EnumerateArray())
                                {
                                    <div class="menu-item-row">
                                        <div class="item-name">
                                            <strong>@itemId.GetString()</strong>
                                        </div>
                                    </div>
                                }
                            }
                            
                            if (menuData.Value.TryGetProperty("pricePerPerson", out var pricePerPerson))
                            {
                                <div class="menu-item-row">
                                    <div class="item-name">ราคาต่อคน</div>
                                    <div class="item-price">฿ @pricePerPerson.GetDecimal().ToString("N2")</div>
                                </div>
                            }
                        }
                        catch { }
                    </div>
                </div>
            }

            <div class="price-summary-section">
                <div class="detail-row total">
                    <span class="label">ราคารวม:</span>
                    <span class="value price">฿ @Model.TotalPrice?.ToString("N2")</span>
                </div>
            </div>

            <div class="detail-row">
                <span class="label">สถานะ:</span>
                <span class="value status @Model.BookingStatus">@(Model.BookingStatus switch { "confirmed" => "ยืนยันแล้ว", "cancelled" => "ยกเลิกแล้ว", _ => "รอการยืนยัน" })</span>
            </div>

            <div class="info-box">
                <h4>📌 ข่าวสาร สำคัญ</h4>
                <ul>
                    <li>เราจะติดต่อยืนยันการจองของคุณในภายใน 24 ชั่วโมง</li>
                    <li>ชำระเงินได้เมื่อได้รับการยืนยัน</li>
                    <li>หากมีคำถามติดต่อเราได้ตามเบอร์ที่ลงทะเบียน</li>
                </ul>
            </div>
        </div>

        <div class="confirmation-actions">
            <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-primary">ดูการจองของฉัน</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline">กลับหน้าแรก</a>
        </div>
    </div>
</div>

<style>
.confirmation-container {
    max-width: 700px;
    margin: 40px auto;
    padding: 20px;
}

.confirmation-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(217, 119, 6, 0.2);
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    text-align: center;
}

.confirmation-card.success {
    border-color: rgba(16, 185, 129, 0.3);
}

.success-icon {
    width: 80px;
    height: 80px;
    background: rgba(16, 185, 129, 0.2);
    border: 2px solid #10b981;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48px;
    color: #10b981;
    margin: 0 auto 20px;
    animation: scaleIn 0.6s ease-out;
}

@@keyframes scaleIn {
    from {
        transform: scale(0);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.confirmation-card h2 {
    font-size: 28px;
    font-weight: 700;
    color: #10b981;
    margin-bottom: 8px;
}

.success-subtitle {
    color: #999;
    font-size: 16px;
    margin-bottom: 30px;
}

.booking-details {
    text-align: left;
    margin: 30px 0;
}

.detail-section {
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 20px;
}

.detail-section h3 {
    font-size: 16px;
    font-weight: 600;
    color: #ddd;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid rgba(16, 185, 129, 0.2);
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid rgba(217, 119, 6, 0.1);
    font-size: 14px;
}

.detail-row:last-child {
    border-bottom: none;
}

.detail-row.total {
    padding: 15px 0;
    border-top: 2px solid rgba(217, 119, 6, 0.2);
    border-bottom: none;
    font-weight: 600;
    font-size: 16px;
}

.detail-row .label {
    color: #999;
    font-weight: 500;
}

.detail-row .value {
    color: #ddd;
    text-align: right;
}

.booking-id {
    background: rgba(217, 119, 6, 0.2);
    color: #d97706;
    padding: 4px 12px;
    border-radius: 6px;
    font-family: monospace;
    font-weight: 600;
}

.status {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.status.pending {
    background: rgba(251, 191, 36, 0.2);
    color: #fbbf24;
}

.price {
    color: #d97706;
    font-size: 18px;
    font-weight: 700;
}

/* Menu Details Styles */
.menu-details-section {
    background: rgba(255, 193, 7, 0.05);
    border: 1px solid rgba(255, 193, 7, 0.2);
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 20px;
}

.menu-details-section h3 {
    font-size: 16px;
    font-weight: 600;
    color: #ffc107;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid rgba(255, 193, 7, 0.2);
}

.menu-items-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.menu-item-row {
    background: rgba(255, 255, 255, 0.05);
    padding: 12px;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 15px;
    border-left: 3px solid #ffc107;
}

.item-name {
    flex: 1;
    color: #fff;
    font-size: 14px;
}

.item-name strong {
    display: block;
    margin-bottom: 4px;
}

.item-category {
    color: #ffc107;
    font-size: 12px;
    font-weight: 500;
}

.item-details {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    font-size: 13px;
    color: #ddd;
}

.separator {
    color: #666;
}

.unit-price {
    color: #ffc107;
    font-weight: 600;
}

.total-price {
    color: #10b981;
    font-weight: 700;
}

.quantity {
    color: #999;
}

.price-summary-section {
    background: linear-gradient(135deg, rgba(217, 119, 6, 0.15), rgba(217, 119, 6, 0.05));
    border: 1px solid rgba(217, 119, 6, 0.3);
    border-radius: 10px;
    padding: 20px;
    margin-bottom: 20px;
}

.info-box {
    background: rgba(59, 130, 246, 0.05);
    border-left: 4px solid #3b82f6;
    border-radius: 10px;
    padding: 20px;
    margin: 20px 0;
    text-align: left;
}

.info-box h4 {
    color: #60a5fa;
    font-size: 14px;
    margin: 0 0 12px 0;
}

.info-box ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.info-box li {
    color: #999;
    font-size: 13px;
    padding: 6px 0;
    padding-left: 20px;
    position: relative;
}

.info-box li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #10b981;
    font-weight: bold;
}

.text-muted {
    color: #666;
}

.confirmation-actions {
    display: flex;
    gap: 15px;
    margin-top: 30px;
}

.btn {
    flex: 1;
    padding: 12px 20px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 15px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
    text-decoration: none;
    display: inline-block;
}

.btn-primary {
    background: linear-gradient(135deg, #d97706 0%, #f97316 100%);
    color: white;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(217, 119, 6, 0.4);
}

.btn-outline {
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
}

@@media (max-width: 600px) {
    .confirmation-container {
        margin: 20px auto;
        padding: 10px;
    }

    .confirmation-card {
        padding: 25px;
    }

    .booking-details {
        margin: 20px 0;
    }

    .menu-item-row {
        flex-direction: column;
        gap: 8px;
    }

    .item-details {
        width: 100%;
        flex-wrap: wrap;
    }

    .confirmation-actions {
        flex-direction: column;
    }

    .btn {
        padding: 10px 15px;
        font-size: 14px;
    }
}
</style>
