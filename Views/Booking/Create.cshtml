@{
    ViewData["Title"] = "ออกแบบเมนูและจองเลยตอนนี้";
}

<div class="booking-container">
    <div class="booking-card">
        <div class="booking-header">
            <h2>🍽️ ออกแบบเมนูของคุณ</h2>
            <p>เลือกเมนูอาหารที่ต้องการและจองเลยตอนนี้</p>
        </div>

        <form asp-controller="Booking" asp-action="Create" method="post" class="booking-form" id="bookingForm">
            <div class="booking-content">
                <!-- Left: Menu Selection -->
                <div class="booking-left">
                    <div class="booking-section menu-section">
                        <h3>🎯 เลือกเมนูอาหาร</h3>
                        <div class="menu-categories">
                            @if (ViewBag.MenuItemsByCategory != null)
                            {
                                @foreach (var category in ViewBag.MenuItemsByCategory)
                                {
                                    <div class="menu-category">
                                        <h4>@category.Key</h4>
                                        <div class="menu-items">
                                            @foreach (var item in category.Value)
                                            {
                                                <div class="menu-item">
                                                    <div class="item-info">
                                                        <span class="item-name">@item.ItemName</span>
                                                        <span class="item-price">฿ @item.BasePrice.ToString("N2")</span>
                                                    </div>
                                                    <div class="item-checkbox">
                                                        <input type="checkbox" 
                                                               id="menu_@item.MenuItemId" 
                                                               name="menu_@item.MenuItemId"
                                                               value="@item.MenuItemId"
                                                               class="menu-checkbox" 
                                                               onchange="updateTotalPrice()"
                                                               data-price="@item.BasePrice">
                                                        <label for="menu_@item.MenuItemId" class="checkbox-label">เลือก</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Right: Information & Summary -->
                <div class="booking-right">
                    <!-- Guest Information -->
                    <div class="booking-section">
                        <h3>📋 ข้อมูลทั่วไป</h3>
                        
                        <div class="form-group">
                            <label for="TotalGuests" class="form-label">จำนวนคน <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="TotalGuests" name="TotalGuests" 
                                   min="2" max="200" required placeholder="เช่น 50" onchange="updateTotalPrice()">
                            <small class="form-text">2-200 คน</small>
                        </div>

                        <div class="form-group">
                            <label for="EventDate" class="form-label">วันที่จัดงาน</label>
                            <input type="date" class="form-control" id="EventDate" name="EventDate">
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="booking-section">
                        <h3>📞 ข้อมูลติดต่อ</h3>

                        <div class="form-group">
                            <label for="EventLocation" class="form-label">ที่อยู่จัดงาน <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="EventLocation" name="EventLocation" 
                                      rows="3" required placeholder="กรุณากรอกที่อยู่โดยละเอียด">@ViewBag.UserAddress</textarea>
                        </div>

                        <div class="form-group">
                            <label for="UserPhone" class="form-label">เบอร์ติดต่อ <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="UserPhone" name="UserPhone" 
                                   required placeholder="เช่น 08X-XXX-XXXX" value="@ViewBag.UserPhone">
                        </div>
                    </div>

                    <!-- Price Summary -->
                    <div class="booking-section price-summary">
                        <h3>💰 สรุปราคา</h3>
                        <div class="price-row">
                            <span>ราคาเมนูอาหาร:</span>
                            <span id="menuPrice">฿ 0</span>
                        </div>
                        <div class="price-row">
                            <span>ค่าดำเนินการ:</span>
                            <span id="operationFee">฿ 0</span>
                        </div>
                        <div class="price-row">
                            <span>จำนวนคน:</span>
                            <span id="guestCount">0</span>
                        </div>
                        <div class="price-row total">
                            <span>ราคารวม:</span>
                            <span id="totalPrice" class="price-highlight">฿ 0</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="booking-actions">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline">ยกเลิก</a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">✓ จองเลยตอนนี้</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<style>
.booking-container {
    max-width: 1400px;
    margin: 40px auto;
    padding: 20px;
}

.booking-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    padding: 30px;
    backdrop-filter: blur(10px);
}

.booking-header {
    text-align: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.booking-header h2 {
    color: #fff;
    font-size: 28px;
    margin-bottom: 10px;
}

.booking-header p {
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
}

/* Two Column Layout */
.booking-content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 30px;
    align-items: start;
}

.booking-left {
    max-height: 800px;
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 8px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
}

.booking-left::-webkit-scrollbar {
    width: 6px;
}

.booking-left::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
}

.booking-left::-webkit-scrollbar-thumb {
    background: rgba(255, 193, 7, 0.4);
    border-radius: 3px;
}

.booking-left::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 193, 7, 0.6);
}

.booking-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.booking-section {
    margin-bottom: 0;
}

.booking-section h3 {
    color: #fff;
    font-size: 16px;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
}

.menu-section {
    background: rgba(255, 255, 255, 0.05);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.menu-categories {
    display: grid;
    gap: 20px;
}

.menu-category h4 {
    color: #ffc107;
    font-size: 14px;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

.menu-items {
    display: grid;
    gap: 10px;
}

.menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    padding: 10px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    gap: 10px;
}

.menu-item:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 200, 107, 0.3);
}

.item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
}

.item-name {
    color: #fff;
    font-weight: 500;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.item-price {
    color: #ffc107;
    font-size: 12px;
    font-weight: 600;
}

.item-quantity {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.1);
    padding: 4px;
    border-radius: 3px;
    flex-shrink: 0;
}

.item-checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.menu-checkbox {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: #ffc107;
}

.checkbox-label {
    cursor: pointer;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 8px;
    background: rgba(255, 193, 7, 0.1);
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 3px;
    transition: all 0.2s;
}

.menu-checkbox:checked + .checkbox-label {
    background: #ffc107;
    color: #000;
    border-color: #ffc107;
}

.qty-btn {
    width: 24px;
    height: 24px;
    border: none;
    background: #ffc107;
    color: #000;
    border-radius: 2px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.qty-btn:hover {
    background: #ffb300;
    transform: scale(1.05);
}

.qty-input {
    width: 40px;
    text-align: center;
    border: none;
    background: transparent;
    color: #fff;
    font-weight: bold;
    font-size: 12px;
}

.qty-input:focus {
    outline: none;
}

.form-group {
    margin-bottom: 15px;
}

.form-label {
    color: #fff;
    font-weight: 500;
    margin-bottom: 6px;
    display: block;
    font-size: 14px;
}

.form-control {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    padding: 8px 10px;
    border-radius: 5px;
    font-size: 13px;
    width: 100%;
    box-sizing: border-box;
}

.form-control::placeholder {
    color: rgba(255, 255, 255, 0.4);
}

.form-control:focus {
    background: rgba(255, 255, 255, 0.12);
    border-color: #ffc107;
    color: #fff;
    outline: none;
}

.form-text {
    color: rgba(255, 255, 255, 0.5) !important;
    font-size: 12px;
    margin-top: 3px;
    display: block;
}

.text-danger {
    color: #ff6b6b;
}

.price-summary {
    background: linear-gradient(135deg, rgba(255, 193, 7, 0.1), rgba(255, 193, 7, 0.05));
    border: 2px solid rgba(255, 193, 7, 0.3);
    padding: 20px;
    border-radius: 10px;
    position: sticky;
    top: 20px;
}

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.price-row.total {
    border-bottom: none;
    padding-top: 12px;
    margin-top: 12px;
    font-size: 16px;
    font-weight: bold;
    color: #fff;
    border-top: 1px solid rgba(255, 193, 7, 0.3);
}

.price-highlight {
    color: #ffc107;
    font-size: 20px;
    font-weight: bold;
}

.booking-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 20px;
}

.btn {
    padding: 11px 16px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    text-align: center;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-primary {
    background: linear-gradient(135deg, #ffc107, #ffb300);
    color: #000;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #ffb300, #ff9f00);
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
}

.btn-outline {
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.3);
}

.btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    color: #fff;
}

/* Responsive Design */
@@media (max-width: 1024px) {
    .booking-content {
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .booking-left {
        max-height: 600px;
        border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
}

@@media (max-width: 768px) {
    .booking-container {
        margin: 20px auto;
        padding: 15px;
    }

    .booking-card {
        padding: 20px;
    }

    .booking-header h2 {
        font-size: 22px;
    }

    .booking-content {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .booking-left {
        max-height: none;
        border-right: none;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding-right: 0;
        padding-bottom: 20px;
        margin-bottom: 10px;
    }

    .menu-item {
        flex-wrap: wrap;
    }

    .item-checkbox {
        align-self: flex-end;
        margin-top: 8px;
        width: 100%;
        justify-content: flex-end;
    }

    .booking-actions {
        grid-template-columns: 1fr;
    }

    .price-summary {
        position: static;
    }
}
</style>

<script>
// Calculate operation fee based on guest count
function getOperationFee(guestCount) {
    if (guestCount >= 2 && guestCount <= 10) return 5000;
    if (guestCount >= 11 && guestCount <= 20) return 9000;
    if (guestCount >= 21 && guestCount <= 35) return 12000;
    if (guestCount >= 36 && guestCount <= 50) return 15000;
    if (guestCount >= 60 && guestCount <= 80) return 25000;
    if (guestCount >= 81) return 40000;
    return 0;
}

function updateTotalPrice() {
    // Get sum of selected menu items prices
    let pricePerPerson = 0;
    const checkboxes = document.querySelectorAll('.menu-checkbox:checked');
    
    checkboxes.forEach(checkbox => {
        const price = parseFloat(checkbox.dataset.price) || 0;
        pricePerPerson += price;
    });

    const guestCount = parseInt(document.getElementById('TotalGuests').value) || 0;
    const operationFee = getOperationFee(guestCount);
    
    // Menu price = price per person × number of guests
    const menuPrice = pricePerPerson * guestCount;
    const totalPrice = menuPrice + operationFee;

    document.getElementById('menuPrice').textContent = `฿ ${menuPrice.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    document.getElementById('operationFee').textContent = `฿ ${operationFee.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    document.getElementById('guestCount').textContent = guestCount;
    document.getElementById('totalPrice').textContent = `฿ ${totalPrice.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    updateTotalPrice();
});

// Form validation
document.getElementById('bookingForm').addEventListener('submit', function(e) {
    const selectedItems = Array.from(document.querySelectorAll('.menu-checkbox:checked'));
    
    if (selectedItems.length === 0) {
        e.preventDefault();
        alert('กรุณาเลือกเมนูอาหารอย่างน้อยหนึ่งรายการ');
    }
});
</script>
