@model BookingViewModel
@using System.Globalization
@using System.Text.Json
@using EventPack.Models.Db
@{
    ViewData["Title"] = "ออกแบบเมนูและจอง";
    var categories = (Dictionary<string, List<MenuItem>>)ViewBag.MenuItemsByCategory;
    var submitted = Context.Request.HasFormContentType ? Context.Request.Form : null;
}
<section class="container py-4">
    <h1>ออกแบบเมนูของคุณ</h1>
    <p>เลือกอาหาร ระบุจำนวนแขก และตรวจราคาก่อนส่งรายการให้ผู้ดูแลยืนยัน</p>
    <form asp-controller="Booking" asp-action="Create" method="post" id="bookingForm">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="row g-4">
            <div class="col-md-7">
                @foreach (var category in categories)
                {
                    <fieldset class="border rounded p-3 mb-3">
                        <legend class="h5">@category.Key</legend>
                        @foreach (var item in category.Value)
                        {
                            var name = $"menu_{item.MenuItemId}";
                            <label class="d-flex align-items-center gap-2 mb-2">
                                <input type="checkbox" class="form-check-input menu-checkbox" name="@name" value="true" checked="@(submitted?.ContainsKey(name) == true)" data-price="@item.BasePrice.ToString(CultureInfo.InvariantCulture)" />
                                @item.ItemName · ฿@item.BasePrice.ToString("N2") / คน
                            </label>
                        }
                    </fieldset>
                }
            </div>
            <div class="col-md-5">
                <div class="card p-3">
                    <label asp-for="TotalGuests">จำนวนแขก</label>
                    <input asp-for="TotalGuests" class="form-control mb-2" type="number" min="2" max="200" required />
                    <label asp-for="EventDate">วันจัดงาน</label>
                    <input asp-for="EventDate" class="form-control mb-2" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required />
                    <label asp-for="EventLocation">สถานที่จัดงาน</label>
                    <textarea asp-for="EventLocation" class="form-control mb-2" maxlength="255" required></textarea>
                    <label asp-for="UserPhone">เบอร์ติดต่อ</label>
                    <input asp-for="UserPhone" class="form-control mb-3" type="tel" maxlength="15" required />
                    <dl class="row mb-2">
                        <dt class="col-7">ค่าอาหาร</dt><dd id="menuPrice" class="col-5 text-end">—</dd>
                        <dt class="col-7">ค่าดำเนินการ</dt><dd id="operationFee" class="col-5 text-end">—</dd>
                        <dt class="col-7">ยอดรวม</dt><dd id="totalPrice" class="col-5 text-end fw-bold" aria-live="polite">—</dd>
                    </dl>
                    <p class="small">รับจอง 2–50 หรือ 60–200 คน เว็บไซต์พอร์ตใช้ข้อมูลตัวอย่างและไม่มีการรับชำระเงิน</p>
                    <button class="btn btn-primary" type="submit">ส่งรายการจอง</button>
                </div>
            </div>
        </div>
    </form>
</section>
<script>
    const form = document.getElementById('bookingForm');
    const tiers = @Html.Raw(JsonSerializer.Serialize((int[][])ViewBag.FeeTiers));
    const currency = new Intl.NumberFormat('th-TH', { style: 'currency', currency: 'THB' });
    function updateQuote() {
        const guests = document.getElementById('TotalGuests').valueAsNumber;
        const tier = tiers.find(([min, max]) => guests >= min && guests <= max);
        const items = [...form.querySelectorAll('.menu-checkbox:checked')];
        const subtotal = items.reduce((sum, item) => sum + Number(item.dataset.price), 0) * guests;
        document.getElementById('menuPrice').textContent = tier && items.length ? currency.format(subtotal) : '—';
        document.getElementById('operationFee').textContent = tier ? currency.format(tier[2]) : '—';
        document.getElementById('totalPrice').textContent = tier && items.length ? currency.format(subtotal + tier[2]) : '—';
    }
    form.addEventListener('input', updateQuote);
    updateQuote();
</script>
