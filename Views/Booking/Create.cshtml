@{
    ViewData["Title"] = "ออกแบบเมนูและจองเลยตอนนี้";
}

<div class="booking-container">
    <div class="booking-card">
        <div class="booking-header">
            <h2>🍽️ ออกแบบเมนูของคุณ</h2>
            <p>เลือกเมนูอาหารที่ต้องการและจองเลยตอนนี้</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px; background: rgba(220, 53, 69, 0.2); border: 1px solid rgba(220, 53, 69, 0.5); border-radius: 6px; color: #ff6b6b;">
                <strong>❌ ข้อผิดพลาด:</strong>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-controller="Booking" asp-action="Create" method="post" class="booking-form" id="bookingForm" enctype="multipart/form-data">
            <div class="booking-content">
                <!-- Left: Menu Selection -->
                <div class="booking-left">
                    <!-- Menu Items Selection -->
                    <div class="booking-section menu-section">
                        <h3>🎯 เลือกเมนูอาหาร</h3>
                        <div class="menu-categories">
                            @if (ViewBag.MenuItemsByCategory != null && ViewBag.MenuItemsByCategory.Count > 0)
                            {
                                @foreach (var category in ViewBag.MenuItemsByCategory)
                                {
                                    <div class="menu-category">
                                        <h4>@category.Key</h4>
                                        <div class="menu-items">
                                            @foreach (var item in category.Value)
                                            {
                                                <div class="menu-item">
                                                    <div class="item-info">
                                                        <span class="item-name">@item.ItemName</span>
                                                        <span class="item-price">฿ @item.BasePrice.ToString("N2")</span>
                                                    </div>
                                                    <div class="item-checkbox">
                                                        <input type="checkbox" 
                                                               id="menu_@item.MenuItemId" 
                                                               name="menu_@item.MenuItemId"
                                                               value="@item.MenuItemId"
                                                               class="menu-checkbox" 
                                                               onchange="updateTotalPrice()"
                                                               data-price="@item.BasePrice">
                                                        <label for="menu_@item.MenuItemId" class="checkbox-label">เลือก</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p style="color: #999;">ไม่มีรายการเมนูให้เลือก</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Right: Information & Summary -->
                <div class="booking-right">
                    <!-- Guest Information -->
                    <div class="booking-section">
                        <h3>📋 ข้อมูลทั่วไป</h3>
                        
                        <div class="form-group">
                            <label for="TotalGuests" class="form-label">จำนวนคน <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="TotalGuests" name="TotalGuests" 
                                   min="2" max="200" required placeholder="เช่น 50" onchange="updateTotalPrice()">
                            <small class="form-text">2-200 คน</small>
                        </div>

                        <div class="form-group">
                            <label for="EventDate" class="form-label">วันที่จัดงาน</label>
                            <input type="date" class="form-control" id="EventDate" name="EventDate">
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div class="booking-section">
                        <h3>📞 ข้อมูลติดต่อ</h3>

                        <div class="form-group">
                            <label for="EventLocation" class="form-label">ที่อยู่จัดงาน <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="EventLocation" name="EventLocation" 
                                      rows="3" required placeholder="กรุณากรอกที่อยู่โดยละเอียด">@ViewBag.UserAddress</textarea>
                        </div>

                        <div class="form-group">
                            <label for="UserPhone" class="form-label">เบอร์ติดต่อ <span class="text-danger">*</span></label>
                            <input type="tel" class="form-control" id="UserPhone" name="UserPhone" 
                                   required placeholder="เช่น 08X-XXX-XXXX" value="@ViewBag.UserPhone">
                        </div>
                    </div>

                    <!-- Price Summary -->
                    <div class="booking-section price-summary">
                        <h3>💰 สรุปราคา</h3>
                        <div class="price-row">
                            <span>ราคาเมนูอาหาร:</span>
                            <span id="menuPrice">฿ 0</span>
                        </div>
                        <div class="price-row">
                            <span>ค่าดำเนินการ:</span>
                            <span id="operationFee">฿ 0</span>
                        </div>
                        <div class="price-row">
                            <span>จำนวนคน:</span>
                            <span id="guestCount">0</span>
                        </div>
                        <div class="price-row total">
                            <span>ราคารวม:</span>
                            <span id="totalPrice" class="price-highlight">฿ 0</span>
                        </div>
                    </div>

                    <!-- Payment Confirmation Section -->
                    <div class="booking-section payment-section">
                        <h3>💳 ยืนยันการชำระเงิน</h3>
                        
                        <!-- Payment Button -->
                        <button type="button" id="paymentBtn" class="btn btn-payment" onclick="openPaymentModal()">
                            📱 ชำระเงิน
                        </button>
                    </div>

                    <!-- Actions -->
                    <div class="booking-actions">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline">ยกเลิก</a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">✓ ยืนยันการจอง</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Payment Modal -->
<div id="paymentModal" class="payment-modal">
    <div class="payment-modal-content">
        <span class="payment-modal-close" onclick="closePaymentModal()">&times;</span>
        <h2 class="modal-title">💳 ชำระเงิน</h2>
        
        <div class="modal-body">
            <!-- QR Code Section -->
            <div class="qr-code-box-modal">
                <div class="qr-code-label-modal">📱 สแกน QR Code เพื่อชำระเงิน</div>
                <div class="qr-code-container-modal">
                    <img src="~/QR/QRCode.png" alt="QR Code Payment" class="qr-code-image-modal">
                </div>
                <div class="payment-details">
                    <p><strong>ยอดที่ต้องจ่าย:</strong></p>
                    <div class="payment-amount-modal">฿ <span id="paymentAmountModal">0</span></div>
                </div>
            </div>

            <!-- Payment Proof Upload Section in Modal -->
            <div class="modal-payment-proof">
                <div class="form-group-modal">
                    <label for="PaymentProof" class="form-label-modal">📸 อัพโหลดหลักฐานการชำระเงิน <span class="text-danger">*</span></label>
                    <div class="file-upload-box-modal">
                        <input type="file" 
                               id="PaymentProof" 
                               name="PaymentProof" 
                               accept="image/*" 
                               class="file-input-modal"
                               required>
                        <label for="PaymentProof" class="file-label-modal">
                            <span class="file-icon-modal">📷</span>
                            <span class="file-text-modal" id="fileNameModal">คลิกเพื่อเลือกรูปภาพ</span>
                        </label>
                        <small class="form-text-modal">รองรับไฟล์: JPG, PNG, GIF (ไม่เกิน 5MB)</small>
                    </div>
                </div>

                <div class="payment-note-modal" id="paymentNoteModal" style="display: none;">
                    <span class="note-icon">✓</span>
                    <span class="note-text">ได้รับหลักฐานการชำระเงิน</span>
                </div>
            </div>
        </div>
        
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-modal" onclick="closePaymentModal()">ยกเลิก</button>
            <button type="button" class="btn btn-confirm-modal" onclick="confirmPayment()">ยืนยัน</button>
        </div>
    </div>
</div>

<style>
.booking-container {
    max-width: 950px;
    margin: 30px auto;
    padding: 12px;
    box-sizing: border-box;
}

.booking-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    padding: 20px;
    backdrop-filter: blur(10px);
    box-sizing: border-box;
}

.booking-header {
    text-align: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.booking-header h2 {
    color: #fff;
    font-size: 24px;
    margin-bottom: 8px;
}

.booking-header p {
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
}

/* Two Column Layout */
.booking-content {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 20px;
    align-items: start;
    box-sizing: border-box;
}

.booking-left {
    max-height: 700px;
    overflow-y: auto;
    overflow-x: hidden;
    padding-right: 6px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
}

.booking-left::-webkit-scrollbar {
    width: 6px;
}

.booking-left::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
}

.booking-left::-webkit-scrollbar-thumb {
    background: rgba(255, 193, 7, 0.4);
    border-radius: 3px;
}

.booking-left::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 193, 7, 0.6);
}

.booking-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.booking-section {
    margin-bottom: 0;
}

.booking-section h3 {
    color: #fff;
    font-size: 15px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
}

.menu-section {
    background: rgba(255, 255, 255, 0.05);
    padding: 20px;
    border-radius: 10px;
    border: 1px solid rgba(6, 1, 1, 0.1);
}

.menu-categories {
    display: grid;
    gap: 20px;
}

.menu-category h4 {
    color: #ffc107;
    font-size: 14px;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
}

.menu-items {
    display: grid;
    gap: 8px;
}

.menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.08);
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all 0.3s ease;
    gap: 8px;
}

.menu-item:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 200, 107, 0.3);
}

.item-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.item-name {
    color: #0a0202;
    font-weight: 500;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.item-price {
    color: #ffc107;
    font-size: 11px;
    font-weight: 600;
}

.item-quantity {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.1);
    padding: 4px;
    border-radius: 3px;
    flex-shrink: 0;
}

.item-checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

.menu-checkbox {
    width: 20px;
    height: 20px;
    cursor: pointer;
    accent-color: #ffc107;
}

.checkbox-label {
    cursor: pointer;
    color: #100404;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 8px;
    background: rgba(255, 193, 7, 0.1);
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 3px;
    transition: all 0.2s;
}

.menu-checkbox:checked + .checkbox-label {
    background: #ffc107;
    color: #000;
    border-color: #ffc107;
}

.qty-btn {
    width: 24px;
    height: 24px;
    border: none;
    background: #ffc107;
    color: #000;
    border-radius: 2px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.qty-btn:hover {
    background: #ffb300;
    transform: scale(1.05);
}

.qty-input {
    width: 40px;
    text-align: center;
    border: none;
    background: transparent;
    color: #0f0101;
    font-weight: bold;
    font-size: 12px;
}

.qty-input:focus {
    outline: none;
}

.form-group {
    margin-bottom: 12px;
}

.form-label {
    color: #120303;
    font-weight: 500;
    margin-bottom: 4px;
    display: block;
    font-size: 13px;
}

.form-control {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #120404;
    padding: 6px 8px;
    border-radius: 5px;
    font-size: 12px;
    width: 100%;
    box-sizing: border-box;
}

.form-control::placeholder {
    color: rgba(255, 255, 255, 0.4);
}

.form-control:focus {
    background: rgba(255, 255, 255, 0.12);
    border-color: #ffc107;
    color: #030000;
    outline: none;
}

.form-text {
    color: rgba(36, 11, 11, 0.5) !important;
    font-size: 12px;
    margin-top: 3px;
    display: block;
}

.text-danger {
    color: #ff6b6b;
}

.price-summary {
    background: linear-gradient(135deg, rgba(255, 193, 7, 0.1), rgba(255, 193, 7, 0.05));
    border: 2px solid rgba(255, 193, 7, 0.3);
    padding: 15px;
    border-radius: 10px;
    position: sticky;
    top: 20px;
}

.price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.price-row.total {
    border-bottom: none;
    padding-top: 10px;
    margin-top: 10px;
    font-size: 15px;
    font-weight: bold;
    color: #fff;
    border-top: 1px solid rgba(255, 193, 7, 0.3);
}

.price-highlight {
    color: #ffc107;
    font-size: 18px;
    font-weight: bold;
}

/* Payment Section */
.payment-section {
    background: rgba(46, 80, 144, 0.1);
    border: 2px solid rgba(46, 80, 144, 0.3);
    padding: 15px;
    border-radius: 10px;
}

.payment-section h3 {
    color: #fff;
    font-size: 15px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
}

.qr-code-box {
    background: rgba(255, 255, 255, 0.05);
    padding: 15px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 15px;
}

.qr-code-label {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 10px;
    display: block;
}

.qr-code-container {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
    background: #fff;
    padding: 10px;
    border-radius: 6px;
}

.qr-code-image {
    max-width: 200px;
    width: 100%;
    height: auto;
    border-radius: 4px;
}

.qr-code-info {
    text-align: center;
    color: rgba(255, 255, 255, 0.8);
    font-size: 13px;
}

.payment-amount {
    color: #ffc107;
    font-size: 20px;
    font-weight: bold;
    margin-top: 5px;
}

/* File Upload */
.file-upload-box {
    position: relative;
    margin-top: 8px;
}

.file-input {
    display: none;
}

.file-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30px 15px;
    background: rgba(255, 255, 255, 0.08);
    border: 2px dashed rgba(255, 193, 7, 0.4);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    min-height: 120px;
}

.file-label:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 193, 7, 0.6);
}

.file-input:focus + .file-label {
    border-color: #ffc107;
    background: rgba(255, 193, 7, 0.1);
}

.file-icon {
    font-size: 32px;
    margin-bottom: 8px;
}

.file-text {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 600;
    font-size: 14px;
    text-align: center;
}

.file-input:valid + .file-label .file-text {
    color: #ffc107;
}

.payment-note {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: rgba(39, 174, 96, 0.2);
    border: 1px solid rgba(39, 174, 96, 0.4);
    border-radius: 6px;
    color: #52d273;
    font-size: 13px;
    margin-top: 10px;
}

.note-icon {
    font-size: 16px;
}

/* Payment Button */
.btn-payment {
    width: 100%;
    padding: 12px 16px;
    background: linear-gradient(135deg, #2E5090 0%, #3D5E8F 100%);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-bottom: 15px;
}

.btn-payment:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(46, 80, 144, 0.4);
}

.btn-payment:active {
    transform: translateY(0);
}

/* Payment Modal */
.payment-modal {
    display: none;
    position: fixed;
    z-index: 2000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
    animation: fadeIn 0.3s ease;
}

@@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.payment-modal-content {
    background-color: #f5f3f0;
    margin: 10% auto;
    padding: 20px;
    border-radius: 15px;
    width: 90%;
    max-width: 420px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: slideDown 0.3s ease;
    box-sizing: border-box;
}

@@keyframes slideDown {
    from {
        transform: translateY(-50px);
        opacity: 0;
    }
    to {
        transform: translateY(0);
        opacity: 1;
    }
}

.payment-modal-close {
    color: #2C3E50;
    float: right;
    font-size: 28px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s ease;
}

.payment-modal-close:hover {
    color: #E74C3C;
    transform: scale(1.2);
}

.modal-title {
    color: #2E5090;
    font-size: 20px;
    margin-bottom: 15px;
    text-align: center;
}

.modal-body {
    margin: 15px 0;
}

.qr-code-box-modal {
    background: #fff;
    padding: 15px;
    border-radius: 10px;
    border: 2px solid #E8D5C4;
    text-align: center;
    margin-bottom: 15px;
}

.qr-code-label-modal {
    color: #2E5090;
    font-weight: 600;
    font-size: 13px;
    margin-bottom: 12px;
    display: block;
}

.qr-code-container-modal {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
    background: #f5f3f0;
    padding: 12px;
    border-radius: 8px;
}

.qr-code-image-modal {
    max-width: 120px;
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 2px solid #2E5090;
}

.payment-details {
    color: #2C3E50;
    font-size: 13px;
}

.payment-details p {
    margin: 4px 0;
    font-weight: 600;
}

.payment-amount-modal {
    color: #D4A574;
    font-size: 22px;
    font-weight: bold;
    margin-top: 8px;
}

/* Payment Proof in Modal */
.modal-payment-proof {
    background: #fff;
    padding: 15px;
    border-radius: 10px;
    border: 2px solid #E8D5C4;
}

.form-group-modal {
    margin-bottom: 12px;
}

.form-label-modal {
    color: #2C3E50;
    font-weight: 600;
    margin-bottom: 6px;
    display: block;
    font-size: 13px;
}

.file-upload-box-modal {
    position: relative;
    margin-top: 6px;
}

.file-input-modal {
    display: none;
}

.file-label-modal {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 18px 12px;
    background: #f5f3f0;
    border: 2px dashed #D4A574;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    min-height: 80px;
}

.file-label-modal:hover {
    background: #efe8e0;
    border-color: #2E5090;
}

.file-input-modal:focus + .file-label-modal {
    border-color: #2E5090;
    background: #e8e0d8;
}

.file-icon-modal {
    font-size: 24px;
    margin-bottom: 6px;
}

.file-text-modal {
    color: #2C3E50;
    font-weight: 600;
    font-size: 12px;
    text-align: center;
}

.form-text-modal {
    color: #999;
    font-size: 11px;
    margin-top: 4px;
    display: block;
}

.payment-note-modal {
    display: none;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    background: rgba(39, 174, 96, 0.2);
    border: 1px solid rgba(39, 174, 96, 0.4);
    border-radius: 6px;
    color: #52d273;
    font-size: 12px;
    margin-top: 8px;
}

.text-danger {
    color: #ff6b6b;
}

.modal-footer {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 18px;
