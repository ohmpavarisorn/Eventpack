<script>
// Calculate operation fee based on guest count
function getOperationFee(guestCount) {
    if (guestCount >= 2 && guestCount <= 10) return 5000;
    if (guestCount >= 11 && guestCount <= 20) return 9000;
    if (guestCount >= 21 && guestCount <= 35) return 12000;
    if (guestCount >= 36 && guestCount <= 50) return 15000;
    if (guestCount >= 60 && guestCount <= 80) return 25000;
    if (guestCount >= 81) return 40000;
    return 0;
}

function updateTotalPrice() {
    // Get sum of selected menu items prices
    let pricePerPerson = 0;
    const checkboxes = document.querySelectorAll('.menu-checkbox:checked');
    
    checkboxes.forEach(checkbox => {
        const price = parseFloat(checkbox.dataset.price) || 0;
        pricePerPerson += price;
    });

    const guestCount = parseInt(document.getElementById('TotalGuests').value) || 0;
    const operationFee = getOperationFee(guestCount);
    
    // Menu price = price per person × number of guests
    const menuPrice = pricePerPerson * guestCount;
    const totalPrice = menuPrice + operationFee;

    document.getElementById('menuPrice').textContent = `฿ ${menuPrice.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    document.getElementById('operationFee').textContent = `฿ ${operationFee.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    document.getElementById('guestCount').textContent = guestCount;
    document.getElementById('totalPrice').textContent = `฿ ${totalPrice.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
    
    // Update modal payment amount
    const paymentAmountModal = document.getElementById('paymentAmountModal');
    if (paymentAmountModal) {
        paymentAmountModal.textContent = totalPrice.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
}

// Payment Modal Functions
function openPaymentModal() {
    const modal = document.getElementById('paymentModal');
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
}

function closePaymentModal() {
    const modal = document.getElementById('paymentModal');
    modal.style.display = 'none';
    document.body.style.overflow = 'auto';
}

function confirmPayment() {
    const paymentProof = document.getElementById('PaymentProof').files;
    
    if (!paymentProof || paymentProof.length === 0) {
        alert('❌ กรุณาอัพโหลดหลักฐานการชำระเงิน');
        return;
    }
    
    const fileSize = (paymentProof[0].size / (1024 * 1024)).toFixed(2);
    if (fileSize > 5) {
        alert('❌ ไฟล์ขนาดใหญ่เกินไป (ต้องไม่เกิน 5MB)');
        document.getElementById('PaymentProof').value = '';
        document.getElementById('fileNameModal').textContent = 'คลิกเพื่อเลือกรูปภาพ';
        document.getElementById('paymentNoteModal').style.display = 'none';
        return;
    }
    
    closePaymentModal();
}

// Close modal when clicking outside of it
window.onclick = function(event) {
    const modal = document.getElementById('paymentModal');
    if (event.target == modal) {
        closePaymentModal();
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    updateTotalPrice();
    
    // File upload handling for payment proof in modal
    const fileInput = document.getElementById('PaymentProof');
    const fileNameDisplay = document.getElementById('fileNameModal');
    const paymentNote = document.getElementById('paymentNoteModal');
    
    if (fileInput) {
        fileInput.addEventListener('change', function(e) {
            if (this.files && this.files[0]) {
                const fileName = this.files[0].name;
                const fileSize = (this.files[0].size / (1024 * 1024)).toFixed(2);
                
                if (fileSize > 5) {
                    alert('❌ ไฟล์ขนาดใหญ่เกินไป (ต้องไม่เกิน 5MB)');
                    this.value = '';
                    fileNameDisplay.textContent = 'คลิกเพื่อเลือกรูปภาพ';
                    paymentNote.style.display = 'none';
                } else {
                    fileNameDisplay.textContent = fileName;
                    paymentNote.style.display = 'block';
                }
            }
        });
    }
});

// Form validation
document.getElementById('bookingForm').addEventListener('submit', function(e) {
    const selectedItems = Array.from(document.querySelectorAll('.menu-checkbox:checked'));
    const paymentProof = document.getElementById('PaymentProof').files;
    
    let errorMsg = '';
    
    if (selectedItems.length === 0) {
        errorMsg += '✗ กรุณาเลือกเมนูอาหารอย่างน้อยหนึ่งรายการ\n';
    }
    
    if (!paymentProof || paymentProof.length === 0) {
        errorMsg += '✗ กรุณาอัพโหลดหลักฐานการชำระเงิน\n';
    }
    
    if (errorMsg) {
        e.preventDefault();
        alert(errorMsg);
    }
});
</script>
