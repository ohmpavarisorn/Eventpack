@model List<EventPack.Models.Db.Booking>

@{
    ViewData["Title"] = "การจองของฉัน";
}

<div class="my-bookings-container">
    <div class="bookings-header">
        <h2>📅 การจองของฉัน</h2>
        <a asp-controller="Booking" asp-action="Create" class="btn btn-primary btn-sm">+ จองใหม่</a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">📦</div>
            <h3>ยังไม่มีการจอง</h3>
            <p>คุณยังไม่ได้ทำการจองเมนูอาหารใด ๆ</p>
            <a asp-controller="Booking" asp-action="Create" class="btn btn-primary">จองเลยตอนนี้</a>
        </div>
    }
    else
    {
        <div class="bookings-list">
            @foreach (var booking in Model.OrderByDescending(b => b.EventDate))
            {
                <div class="booking-card@(booking.BookingStatus == "confirmed" ? " confirmed" : booking.BookingStatus == "cancelled" ? " cancelled" : " pending")">
                    <div class="booking-card-header">
                        <div>
                            <h3>เมนูที่ออกแบบเอง</h3>
                            <span class="booking-id">@booking.BookingId</span>
                        </div>
                        <div class="status-badge @booking.BookingStatus">
                            @GetStatusText(booking.BookingStatus ?? "pending")
                        </div>
                    </div>

                    <div class="booking-card-body">
                        <div class="booking-info-grid">
                            <div class="info-item">
                                <span class="label">📅 วันที่จัดงาน:</span>
                                <span class="value">
                                    @if (booking.EventDate.HasValue)
                                    {
                                        @booking.EventDate.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">ยังไม่ระบุ</span>
                                    }
                                </span>
                            </div>

                            <div class="info-item">
                                <span class="label">👥 จำนวนคน:</span>
                                <span class="value">@booking.TotalGuests คน</span>
                            </div>

                            <div class="info-item">
                                <span class="label">📍 ที่อยู่:</span>
                                <span class="value">@booking.EventLocation</span>
                            </div>

                            <div class="info-item">
                                <span class="label">💰 ราคา:</span>
                                <span class="value price">฿ @booking.TotalPrice?.ToString("N2")</span>
                            </div>
                        </div>

                        @* Menu Items Section *@
                        @if (booking.BookingMenuItems != null && booking.BookingMenuItems.Any())
                        {
                            <div class="menu-items-section">
                                <h4>🍽️ เมนูอาหารที่เลือก:</h4>
                                <div class="menu-items-compact">
                                    @foreach (var item in booking.BookingMenuItems)
                                    {
                                        <span class="menu-item-badge">
                                            @item.MenuItem?.ItemName 
                                            <span class="qty">×@item.Quantity</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="booking-card-footer">
                        <a href="#" class="btn-text">ดูรายละเอียด</a>
                        @if (booking.BookingStatus == "pending")
                        {
                            <button class="btn-text danger">ยกเลิกการจอง</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div class="bookings-footer">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline">กลับหน้าแรก</a>
    </div>
</div>

<style>
.my-bookings-container {
    max-width: 900px;
    margin: 40px auto;
    padding: 20px;
}

.bookings-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(217, 119, 6, 0.2);
}

.bookings-header h2 {
    font-size: 28px;
    font-weight: 700;
    background: linear-gradient(135deg, #f5f5f5 0%, #d97706 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
}

.btn-sm {
    padding: 8px 16px !important;
    font-size: 14px !important;
}

.empty-state {
    text-align: center;
    padding: 60px 20px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(217, 119, 6, 0.2);
    border-radius: 20px;
}

.empty-icon {
    font-size: 64px;
    margin-bottom: 20px;
}

.empty-state h3 {
    font-size: 22px;
    color: #ddd;
    margin-bottom: 10px;
}

.empty-state p {
    color: #999;
    margin-bottom: 30px;
}

.bookings-list {
    display: grid;
    gap: 20px;
    margin-bottom: 30px;
}

.booking-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(217, 119, 6, 0.2);
    border-radius: 15px;
    overflow: hidden;
    transition: all 0.3s ease;
}

.booking-card:hover {
    border-color: rgba(217, 119, 6, 0.4);
    box-shadow: 0 10px 30px rgba(217, 119, 6, 0.1);
    transform: translateY(-2px);
}

.booking-card.confirmed {
    border-color: rgba(16, 185, 129, 0.3);
}

.booking-card.cancelled {
    border-color: rgba(239, 68, 68, 0.3);
    opacity: 0.7;
}

.booking-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background: rgba(217, 119, 6, 0.05);
    border-bottom: 1px solid rgba(217, 119, 6, 0.1);
}

.booking-card-header h3 {
    font-size: 18px;
    font-weight: 600;
    color: #ddd;
    margin: 0 0 5px 0;
}

.booking-id {
    display: inline-block;
    background: rgba(217, 119, 6, 0.2);
    color: #d97706;
    padding: 3px 10px;
    border-radius: 4px;
    font-size: 12px;
    font-family: monospace;
    font-weight: 600;
}

.status-badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
}

.status-badge.pending {
    background: rgba(251, 191, 36, 0.2);
    color: #fbbf24;
}

.status-badge.confirmed {
    background: rgba(16, 185, 129, 0.2);
    color: #10b981;
}

.status-badge.cancelled {
    background: rgba(239, 68, 68, 0.2);
    color: #ef4444;
}

.booking-card-body {
    padding: 20px;
}

.booking-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
}

.info-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.info-item .label {
    color: #999;
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
}

.info-item .value {
    color: #ddd;
    font-size: 14px;
}

.price {
    color: #d97706;
    font-weight: 600;
}

.text-muted {
    color: #666;
}

.menu-items-section {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 193, 7, 0.2);
}

.menu-items-section h4 {
    color: #ffc107;
    font-size: 13px;
    text-transform: uppercase;
    margin: 0 0 10px 0;
    font-weight: 600;
}

.menu-items-compact {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.menu-item-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255, 193, 7, 0.1);
    color: #ffc107;
    padding: 5px 10px;
    border-radius: 12px;
    font-size: 12px;
    border: 1px solid rgba(255, 193, 7, 0.2);
    white-space: nowrap;
}

.menu-item-badge .qty {
    color: #999;
    font-weight: 600;
}

.booking-card-footer {
    display: flex;
    gap: 15px;
    padding: 15px 20px;
    background: rgba(255, 255, 255, 0.01);
    border-top: 1px solid rgba(217, 119, 6, 0.1);
}

.btn-text {
    background: none;
    border: none;
    color: #d97706;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
}

.btn-text:hover {
    color: #f97316;
    text-decoration: underline;
}

.btn-text.danger {
    color: #ef4444;
}

.btn-text.danger:hover {
    color: #f87171;
}

.bookings-footer {
    text-align: center;
}

.btn {
    display: inline-block;
    padding: 12px 30px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 15px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    border: none;
}

.btn-primary {
    background: linear-gradient(135deg, #d97706 0%, #f97316 100%);
    color: white;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(217, 119, 6, 0.4);
}

.btn-outline {
    background: transparent;
    border: 2px solid rgba(217, 119, 6, 0.3);
    color: #ddd;
}

.btn-outline:hover {
    background: rgba(217, 119, 6, 0.1);
    border-color: #d97706;
    color: #f5f5f5;
}

@@media (max-width: 768px) {
    .bookings-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
    }
    
    .booking-card-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
    
    .booking-info-grid {
        grid-template-columns: 1fr;
    }
}
</style>

@functions {
    private string GetStatusText(string status)
    {
        return status switch
        {
            "pending" => "⏳ รอการยืนยัน",
            "confirmed" => "✓ ยืนยันแล้ว",
            "cancelled" => "✕ ยกเลิกแล้ว",
            _ => status
        };
    }
}
