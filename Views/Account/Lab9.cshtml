@model EventPack.ViewModels.Lab9ViewModel

<form asp-action="Lab9" asp-controller="Account" method="post"> 
    UserID <input asp-for="UserID" class="form-control" />
    <br>
    Password <input asp-for="Password" class="form-control" type="password" /> 
    <br>
    Name <input asp-for="Name" class="form-control" />
    <br>
    Lastname <input asp-for="Lastname" class="form-control"/>
    <br>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>