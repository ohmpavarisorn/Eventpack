@{
    ViewData["Title"] = "จัดเลี้ยง";
    var occasions = new[] {
        ("โต๊ะสำหรับครอบครัว", "2–10 คน", "มื้อพิเศษกับคนใกล้ตัว", 6, "salmon"),
        ("งานเลี้ยงกลุ่ม", "11–35 คน", "วันเกิด งานเลี้ยงบริษัท หรืองานสังสรรค์", 20, "roll"),
        ("งานเลี้ยงขนาดใหญ่", "36–50 หรือ 60–200 คน", "ออกแบบเมนูสำหรับแขกหลายโต๊ะ", 60, "salad")
    };
}
<div class="ep-shell">
    <section class="ep-hero">
        <div class="ep-hero-copy">
            <p class="ep-kicker">EVENTPACK · CATERING</p>
            <h1>อาหารดี ๆ<br>สำหรับทุกงานเลี้ยง</h1>
            <p>เลือกเมนูตามใจ กำหนดจำนวนแขก แล้วดูราคาจัดเลี้ยงก่อนส่งคำขอจอง</p>
            <a class="ep-button" asp-controller="Booking" asp-action="Create">จัดเมนูและดูราคา <span aria-hidden="true">↗</span></a>
            <a class="ep-link" href="#occasions">ดูขนาดงาน</a>
        </div>
        <img src="~/images/restaurant/table.webp" alt="โต๊ะจัดเลี้ยงพร้อมซูชิและอาหารหลายจาน" width="1440" height="960" fetchpriority="high" />
    </section>
    <section id="occasions" class="ep-section">
        <h2>จัดโต๊ะให้เหมาะกับงาน</h2>
        <div class="ep-occasions">
            @foreach (var (title, size, description, guests, photo) in occasions)
            {
                <article class="ep-occasion">
                    <img src="@Url.Content($"~/images/restaurant/{photo}.webp")" alt="" width="500" height="500" loading="lazy" />
                    <div><p class="ep-kicker">@size</p><h3>@title</h3><p>@description</p>
                    <a class="ep-text-link" asp-controller="Booking" asp-action="Create" asp-route-guests="@guests">เลือกเมนู <span aria-hidden="true">↗</span></a></div>
                </article>
            }
        </div>
    </section>
</div>
