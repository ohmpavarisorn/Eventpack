<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EVENT PACK</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/register.css" rel="stylesheet" />
    <link href="~/css/packages.css" rel="stylesheet" />
</head>

<body>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1a1a1a; border-bottom: 2px solid #d97706;">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="font-weight: 700; color: #d97706; font-size: 24px;">
            🍽️ EVENT PACK
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">หน้าแรก</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="Index">เกี่ยวกับเรา</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="Index">ติดต่อ</a>
                </li>
            </ul>

            <!-- ปุ่ม Login -->
            <ul class="navbar-nav">
    <li class="nav-item">

        @if (controller == "Account" && action == "Login")
        {
            <a class="btn btn-outline-light"
               asp-controller="Account"
               asp-action="Register">
                Register
            </a>
        }
        else if (controller == "Account" && action == "Register")
        {
            <a class="btn btn-outline-light"
               asp-controller="Account"
               asp-action="Login">
                Login
            </a>
        }
        else
        {
            <a class="btn btn-outline-light"
               asp-controller="Account"
               asp-action="Login">
                Login
            </a>
        }

    </li>
</ul>

        </div>
    </div>
</nav>

<div class="container mt-4">
    @RenderBody()
</div>

<!-- Footer -->
