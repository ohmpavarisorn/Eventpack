<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EVENT PACK</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Site CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/register.css" rel="stylesheet" />
    <link href="~/css/packages.css" rel="stylesheet" />
    <!-- Restaurant Theme -->
    <link href="~/css/restaurant-theme.css" rel="stylesheet" />
    
    @RenderSection("Styles", false)
</head>

<body>
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1a1a1a; border-bottom: 2px solid #d97706;">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index" style="font-weight: 700; color: #d97706; font-size: 24px;">
            🍽️ EVENT PACK
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">หน้าแรก</a>
                </li>
                @if (Context.Session.GetString("Role") == "admin")
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">จัดการการจอง</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Menu">จัดการเมนูอาหาร</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="Create">จองจัดเลี้ยง</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Booking" asp-action="MyBookings">การจองของฉัน</a></li>
                }
            </ul>

            <!-- User Info & Login/Logout -->
            <ul class="navbar-nav">
                @{
                    var userId = Context.Session.GetString("UserId");
                    var fullName = Context.Session.GetString("FullName");
                }
                
                @if (!string.IsNullOrEmpty(userId))
                {
                    <!-- Logged In User -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" style="color: #d97706; font-weight: 600;">
                            👤 @fullName
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark">
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="dropdown-item text-danger" type="submit">ออกจากระบบ</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <!-- Not Logged In -->
                    <li class="nav-item">
                        @if (controller == "Account" && action == "Login")
                        {
                            <a class="btn btn-outline-light" asp-controller="Account" asp-action="Register" style="margin-left: 10px;">
                                สมัครสมาชิก
                            </a>
                        }
                        else if (controller == "Account" && action == "Register")
                        {
                            <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login" style="margin-left: 10px;">
                                เข้าสู่ระบบ
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login" style="margin-left: 10px;">
                                เข้าสู่ระบบ
                            </a>
                        }
                    </li>
                }
            </ul>

        </div>
    </div>
</nav>

<div class="container mt-4">
    @RenderBody()
</div>

<!-- Footer -->
